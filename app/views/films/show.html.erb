

<p id="notice"><%= notice %></p>

<p>
  <strong>Title:</strong>
  <%= @film.title %>
</p>

<p>
  <strong>Description:</strong>
  <%= @film.description %>
</p>

<p>
  <%= image_tag @film.image %>
</p>
<ul>
  <% @film.phavefilms.each do |h| %>
<li>
<%=render h.person%>
<%if h.surname && h.surname.name.to_s.length > 0%>
(<%=h.surname.name%>)
<%end%>
</li>
<%end%>
</ul>

<%= link_to 'Edit Roles', editroles_film_path(@film) %> |
<%= link_to 'Edit', edit_film_path(@film) %> |
<%= link_to 'Back', films_path %>
