<p id="notice"><%= notice %></p>

<h1>Secret questions about cleo</h1>

<table>
  <thead>
    <tr>
      <th>Typeq</th>
      <th>Text</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @secretquestions.each do |secretquestion| %>
      <tr>
        <td><%= secretquestion.typeq %></td>
        <td><%= secretquestion.text %></td>
        <td><%= link_to 'Show', secretquestion %></td>
        <td><%= link_to 'Edit', edit_secretquestion_path(secretquestion) %></td>
        <td><%= link_to 'Destroy', secretquestion, method: :delete, data: { confirm: 'Are you sure?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<br>

<%=form_with url: new_secretquestion_path, html:{method: :get} do |form|%>
<%=label :nb, "creer une nouvelle question avec combien de reponses"%>
<%=number_field_tag :nb%>
<%=form.submit "nouvelle question"%>
<%end%>

<%= link_to 'New Secretquestion', new_secretquestion_path %>
