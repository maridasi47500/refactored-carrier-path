require 'csv'
require 'active_record'
require 'fileutils'


# Function to read data from CSV and create records in the database
def load_data_from_csv(model, file_name)
  CSV.foreach(file_name, headers: true) do |row|
    model.create!(row.to_hash)
  end
end

